
# Database config
DATABASE_URL=postgresql://mab:mab@localhost/mab
REDIS_URL=redis://:mab@localhost:6379

# Keycloak config
KC_BASE_URL=http://localhost:8080
KC_REALM=mab
KC_HEALTH_URL=http://localhost:9000/health
KC_REST_API_AUDIENCE=mab-restapi

## Oauth2 

### clients config (admin-dashboard & KC admin realm-management)
KC_ADMIN_CLIENT_ID=restapi
KC_ADMIN_CLIENT_SECRET=

### clients config (mobile-app)
KC_MOBILE_CLIENT_ID=mobile

# Padrón Nacional fallback (used when the live TSE site is unavailable).
# Operator-downloaded — NOT committed. To obtain it:
#   1. curl -O https://www.tse.go.cr/zip/padron/padron_completo.zip
#   2. unzip padron_completo.zip   # yields PADRON_COMPLETO.txt (~250MB, ISO-8859-1)
#   3. point PADRON_PATH at it (absolute, or relative to apps/restapi/)
# The API refuses to start if this file is missing.
PADRON_PATH=./data/PADRON_COMPLETO.txt