        "@nestjs/core": "^11.1.24",
        "@nestjs/platform-fastify": "^11.1.24",
        "ai": "^6.0.193",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.8.5",
        "ioredis": "^5.11.0",
        "jose": "^6.2.3",
        "keycloak-connect": "^26.1.1",
