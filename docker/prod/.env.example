# =============================================================================
# Mind&Body Production Environment
# Copy this file to .env and fill in ALL values — no defaults are provided.
# =============================================================================

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Redis (cache-only, bound to 127.0.0.1)
REDIS_PASSWORD=
REDIS_PORT=6379

# Keycloak
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HOSTNAME=
