# =============================================================================
# Mind&Body Production Environment
# Copy this file to .env and fill in ALL values — no defaults are provided.
#
# Postgres and Keycloak run on the HOST (not in this compose stack); the
# restapi container reaches them via host.docker.internal.
# =============================================================================

# PostgreSQL on the host. The host's postgres must listen on the docker
# bridge interface and allow the container subnet in pg_hba.conf.
# e.g. postgresql://mab:<password>@host.docker.internal:5432/mab
DATABASE_URL=

# Redis (cache-only, bound to 127.0.0.1)
REDIS_PASSWORD=
REDIS_PORT=6379

# REST API
RESTAPI_PORT=3000
# Public Keycloak URL — must match the `iss` claim in issued tokens
# (e.g. https://auth.example.com)
KC_PUBLIC_URL=
# Host Keycloak's management/health endpoint
# (e.g. http://host.docker.internal:9000/health)
KC_HEALTH_URL=
KC_REALM=mab
KC_REST_API_AUDIENCE=restapi
KC_DASHBOARD_AUDIENCE=mab-admin
KC_ADMIN_CLIENT_ID=restapi
KC_ADMIN_CLIENT_SECRET=
KC_MOBILE_CLIENT_ID=mobile
# Allowed CORS origin (dashboard/web frontend)
CORS_ORIGIN=
# Dashboard URL used for post-auth redirects
DASHBOARD_URL=
# Public URL of this API (OIDC callback host when the dashboard is a static
# site without an /api proxy, e.g. https://restapi-mab.meddyg.com)
API_PUBLIC_URL=

# AI coach (agent module)
OPENAI_API_KEY=
# Forge general + override de mayor calidad para el builder de rutinas.
FORGE_MODEL=gpt-5.6-luna
FORGE_REASONING_EFFORT=medium
FORGE_ROUTINES_MODEL=gpt-5.6-luna
FORGE_ROUTINES_REASONING_EFFORT=medium

# TSE Padrón fallback file — path ON THE HOST to the operator-downloaded
# PADRON_COMPLETO.txt; the compose mounts it read-only into the container
# (e.g. /opt/mab/PADRON_COMPLETO.txt)
PADRON_FILE=
